# PostgreSQL settings
POSTGRES_USER=realtor_user
POSTGRES_PASSWORD=realtor_secret_password
POSTGRES_DB=realtor_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Full SQLAlchemy connection URL (inside Docker network uses host "db")
DATABASE_URL=postgresql+psycopg2://realtor_user:realtor_secret_password@db:5432/realtor_db

# JWT session signing key (change in production!)
SECRET_KEY=change-me-in-production-super-secret-jwt-key

# Application storage directory for uploaded .docx templates, contracts, and photos
STORAGE_DIR=/app/storage

# Agency defaults
AGENCY_NAME=ИП Голубина Ольга Геннадьевна
